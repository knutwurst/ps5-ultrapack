<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>PkgTool</RootNamespace>
    <AssemblyName>ffpfsc-pkg-tool</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Magick.NET's Prospero-facing path is reflection-driven, so trimming
         would rip out the very types the DDS conversion needs. No trim. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The one native library (Magick.Native-Q8-arm64.dll.dylib) ships NEXT TO the
         executable. Bundling it made the .NET host unpack it into ~/.net/ffpfsc-pkg-tool/
         <bundle hash>/ on first run — a new ~27 MB folder for every build, never removed. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- No ReadyToRun precompilation: with it, a Kraken inner-image build of LibProsperoPkg
         d7090eb6 corrupts memory on macOS arm64 about one run in eight (AccessViolationException
         on a Parallel.For replica right after "Metadata tables prepared", FailFast, SIGABRT).
         Measured 2026-10-05 on the homebrew fixture: 0 of 24 runs failed with ReadyToRun code
         disabled at run time, 3 of 24 with it; excluding only LibProsperoPkg.dll from
         precompilation did not help (4 of 24). JIT-compiled the tool is stable. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- LibProsperoPkg 1.2.0 build d7090eb6 (GPL-3.0-or-later) is the one dependency that
         is not on NuGet. lib/ holds the pristine upstream assembly (LibProsperoPkg.dll.orig)
         and the patched one the tool links against; see lib/README.md and
         patches/README.md for the three IL patches and how to re-apply them. -->
    <Reference Include="LibProsperoPkg"><HintPath>lib\LibProsperoPkg.dll</HintPath></Reference>
    <!-- The remaining dependencies are the exact NuGet versions LibProsperoPkg 1.2.0
         was compiled against (assembly versions 2.3.0 / 8.4.0 / 14.15.0). -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
    <!-- Magick.NET is what converts sce_sys/icon0.png to the sce_sys/icon0.dds
         CNT entry the console needs to launch the app (verified against a
         reference package that starts on FW 11.60). LibProsperoPkg fails
         silently if the assembly is absent — the .pkg builds, installs, but
         does not launch. Ships as ~30 MB of the tool (managed + native). -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
  </ItemGroup>
  <!-- patches/CecilPatch is its own project (the LibProsperoPkg.dll patcher); keep the
       SDK's default **/*.cs glob from pulling its sources and obj/ into this assembly. -->
  <ItemGroup>
    <Compile Remove="patches\**" />
    <None Remove="patches\**" />
    <Content Remove="patches\**" />
    <EmbeddedResource Remove="patches\**" />
  </ItemGroup>
</Project>
